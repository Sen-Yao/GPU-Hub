[Unit]
Description=GPUHub Node Agent
After=network.target

[Service]
Type=simple
User=your_user
WorkingDirectory=/path/to/gpuhub
EnvironmentFile=/path/to/private/gpuhub-worker.env
ExecStart=/path/to/python -u /path/to/gpuhub/node_agent/http_server_v4.py
Restart=always
RestartSec=10
StandardOutput=append:/path/to/gpuhub-agent.log
StandardError=append:/path/to/gpuhub-agent.log

[Install]
WantedBy=multi-user.target
